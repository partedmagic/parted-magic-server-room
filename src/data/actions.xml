	<!-- Concrete floor: a terrain job (terrain.xml lists it on every kind);
	     changeTerrain works on the ground under the technician, so the floor
	     lies level with the cell picked.  The old one above built a floor for
	     the level above, a level up in the air; kept for old saves. -->
	<action>
		<id>qdcpave</id>
		<name>Pour a concrete floor</name>

		<priorityID>itemconstruction</priorityID>

		<queue>
			<pick>dcconcrete</pick>
			<moveTerrain />
			<wait>20</wait>
			<moveTerrain />
			<changeTerrain>concrete</changeTerrain>
			<destroyItem />
		</queue>
	</action>

