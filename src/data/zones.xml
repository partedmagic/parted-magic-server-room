<?xml version="1.0" encoding="UTF-8"?>

<zones>

	<zdining>
		<name>Break room</name>
		<!-- SOCIAL: idle technicians rest here (Citizen idles toward SOCIAL
		     zones); eating finds it by its ID, as livingentities' eatZone -->
		<type>SOCIAL</type>
	</zdining>

	<!-- The donut shop (the tavern until 2026-11-01; the ID stays for saves).
	     Guards come only to a site that has one with a donut case (dcbar);
	     a second SOCIAL zone (Leisure): with walls and a roof too it gives
	     every construction worker something to do from day 15 -->
	<ztavern>
		<name>Donut shop</name>
		<type>SOCIAL</type>
		<minWidth>3</minWidth>
		<minHeight>3</minHeight>
	</ztavern>

	<zhospital>
		<name>First aid room</name>
		<type>HOSPITAL</type>
	</zhospital>

	<zpersonal>
		<name>Bunk room</name>
		<type>PERSONAL</type>
		<!-- One technician each, so 2 by 2 (a cot and room to stand), not
		     Towns' 3 by 3: a crew of eleven needs eleven -->
		<minWidth>2</minWidth>
		<minHeight>2</minHeight>
	</zpersonal>

	<zmarket>
		<name>Loading dock</name>
		<!-- WORKSHOP has no behavior; as SOCIAL it drew every idle
		     technician to stand on the dock.  Trucks find it by its ID -->
		<type>WORKSHOP</type>
	</zmarket>

</zones>
