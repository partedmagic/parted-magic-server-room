<?xml version="1.0" encoding="UTF-8"?>
<events>
	<!--
	The day: day, a warm dusk (preevening to evening), night, dawn.  Each
	event tints the map by adding its red, green and blue.  Towns' dusk cut
	mostly green, which turned sand and concrete pink; it now cuts blue
	first, like the dawn, and turns blue toward the night (2026-10-30).
	-->

	<event>
		<id>day</id>
		<name>Day</name>

		<icon>event_day</icon>
		<order>1</order>
		<spawnAtRandom>false</spawnAtRandom>
		<fxRunning>fxrooster</fxRunning>

		<turns>2000</turns>
		<afterEvents>preevening</afterEvents>
	</event>

	<event>
		<id>preevening</id>
		<name>Day</name>

		<icon>event_day</icon>
		<order>1</order>
		<spawnAtRandom>false</spawnAtRandom>

		<red>0</red>
		<green>-0.04</green>
		<blue>-0.1</blue>

		<turns>15</turns>
		<afterEvents>preevening2</afterEvents>
	</event>

	<event>
		<id>preevening2</id>
		<name>Day</name>

		<icon>event_day</icon>
		<order>1</order>
		<spawnAtRandom>false</spawnAtRandom>

		<!-- Half-shadows on every cell -->
		<halfShadows>true</halfShadows>
		<red>0</red>
		<green>-0.08</green>
		<blue>-0.2</blue>

		<turns>15</turns>
		<afterEvents>evening</afterEvents>
	</event>

	<event>
		<id>evening</id>
		<name>Evening</name>

		<icon>event_evening</icon>
		<order>1</order>
		<spawnAtRandom>false</spawnAtRandom>

		<!-- Half-shadows on every cell -->
		<halfShadows>true</halfShadows>
		<red>0</red>
		<green>-0.12</green>
		<blue>-0.3</blue>

		<turns>105</turns>
		<afterEvents>prenight</afterEvents>
	</event>

	<event>
		<id>prenight</id>
		<name>Evening</name>

		<icon>event_evening</icon>
		<order>1</order>
		<spawnAtRandom>false</spawnAtRandom>

		<!-- Half-shadows on every cell -->
		<halfShadows>true</halfShadows>
		<red>-0.1</red>
		<green>-0.16</green>
		<blue>-0.21</blue>

		<turns>15</turns>
		<afterEvents>prenight2</afterEvents>
	</event>

	<event>
		<id>prenight2</id>
		<name>Evening</name>

		<icon>event_evening</icon>
		<order>1</order>
		<spawnAtRandom>false</spawnAtRandom>

		<!-- Half-shadows on every cell -->
		<halfShadows>true</halfShadows>
		<red>-0.2</red>
		<green>-0.2</green>
		<blue>-0.11</blue>

		<turns>15</turns>
		<afterEvents>night</afterEvents>
	</event>

	<event>
		<id>night</id>
		<name>Night</name>

		<icon>event_night</icon>
		<order>1</order>
		<spawnAtRandom>false</spawnAtRandom>

		<fxRunning>fxnighttime</fxRunning>
	
		<!-- Shadows on every cell -->
		<halfShadows>true</halfShadows>
		<red>-0.3</red>
		<green>-0.23</green>
		<blue>-0.02</blue>

		<turns>550</turns>
		<afterEvents>predawn</afterEvents>
	</event>

	<event>
		<id>predawn</id>
		<name>Night</name>

		<icon>event_night</icon>
		<order>1</order>
		<spawnAtRandom>false</spawnAtRandom>

		<!-- Shadows on every cell -->
		<halfShadows>true</halfShadows>
		<red>-0.2</red>
		<green>-0.22</green>
		<blue>-0.11</blue>

		<turns>15</turns>
		<afterEvents>predawn2</afterEvents>
	</event>

	<event>
		<id>predawn2</id>
		<name>Night</name>

		<icon>event_night</icon>
		<order>1</order>
		<spawnAtRandom>false</spawnAtRandom>

		<!-- Shadows on every cell -->
		<halfShadows>true</halfShadows>
		<red>-0.1</red>
		<green>-0.21</green>
		<blue>-0.2</blue>

		<turns>15</turns>
		<afterEvents>dawn</afterEvents>
	</event>

	<event>
		<id>dawn</id>
		<name>dawn</name>

		<icon>event_dawn</icon>
		<order>1</order>
		<spawnAtRandom>false</spawnAtRandom>

		<!-- Half-shadows on every cell -->
		<halfShadows>true</halfShadows>
		<red>0</red>
		<green>-0.2</green>
		<blue>-0.3</blue>

		<turns>105</turns>
		<afterEvents>preday</afterEvents>
	</event>

	<event>
		<id>preday</id>
		<name>dawn</name>

		<icon>event_dawn</icon>
		<order>1</order>
		<spawnAtRandom>false</spawnAtRandom>

		<!-- Half-shadows on every cell -->
		<halfShadows>true</halfShadows>
		<red>0</red>
		<green>-0.1</green>
		<blue>-0.15</blue>

		<turns>15</turns>
		<afterEvents>preday2</afterEvents>
	</event>

	<event>
		<id>preday2</id>
		<name>dawn</name>

		<icon>event_dawn</icon>
		<order>1</order>
		<spawnAtRandom>false</spawnAtRandom>

		<!-- Half-shadows on every cell -->
		<halfShadows>true</halfShadows>
		<red>0</red>
		<green>-0.05</green>
		<blue>-0.07</blue>

		<turns>15</turns>
		<afterEvents>day</afterEvents>
	</event>

	<event>
		<id>cold</id>
		<name>Cold</name>

		<icon>event_cold</icon>
		<order>2</order>

		<!-- Planted things grows slower, but the snow ones -->

		<eventsImmune>hot,extremelyhot</eventsImmune>

		<turns>1440</turns>
	</event>

	<event>
		<id>extremefrost</id>
		<name>Extreme frost</name>

		<icon>event_extremefrost</icon>
		<order>2</order>

		<prerequisites>cold</prerequisites>

		<!-- popo, revisar -->

		<eventsImmune>hot,extremelyhot</eventsImmune>

		<turns>720</turns>
	</event>

	<event>
		<id>hot</id>
		<name>Heat wave</name>
		<!-- The data center's heat wave (DataCenter.rollHeatWave starts it at
		     dawn for 1 to 2 days); air cooling units cool 30% less while it
		     lasts -->
		<spawnAtRandom>false</spawnAtRandom>

		<icon>event_hot</icon>
		<order>2</order>

		<!-- Townies work slower -->
		<waitPCT>120</waitPCT>

		<eventsImmune>cold,extremefrost</eventsImmune>

		<turns>1440</turns>
	</event>

	<event>
		<id>extremelyhot</id>
		<name>Extremely hot</name>

		<icon>event_extremelyhot</icon>
		<order>2</order>

		<prerequisites>hot</prerequisites>

		<!-- Townies work much slower -->
		<waitPCT>160</waitPCT>

		<eventsImmune>cold,extremefrost</eventsImmune>

		<turns>720</turns>
	</event>







	<event>
		<id>cloudy</id>
		<name>Cloudy</name>

		<icon>event_cloudy</icon>
		<order>2</order>

		<prerequisites>day</prerequisites>

		<happinessPCT>80</happinessPCT>

		<turns>360</turns>
	</event>

	<event>
		<id>fallingstars</id>
		<name>Falling stars</name>

		<icon>event_fallingstars</icon>
		<order>3</order>

		<prerequisites>night</prerequisites>

		<happinessPCT>120</happinessPCT>

		<turns>360</turns>
	</event>


	<event>
		<id>fog</id>
		<name>Fog</name>

		<icon>event_fog</icon>
		<order>2</order>

		<prerequisites>cold</prerequisites>

		<!-- Townies walk slower -->
		<walkSpeedPCT>80</walkSpeedPCT>

		<turns>720</turns>
	</event>



	<!-- Rain (the stakes rework): never at random, Weather starts it from the
	     day's forecast and sets its length.  Gray light, and wet ground
	     slows everyone a little -->
	<event>
		<id>rain</id>
		<name>Rain</name>
		<spawnAtRandom>false</spawnAtRandom>
		<icon>event_rain</icon>
		<order>2</order>
		<halfShadows>true</halfShadows>
		<red>-0.14</red>
		<green>-0.12</green>
		<blue>-0.06</blue>
		<walkSpeedPCT>90</walkSpeedPCT>
		<turns>360</turns>
	</event>

	<event>
		<id>rainbow</id>
		<name>Rainbow</name>

		<icon>event_rainbow</icon>
		<order>3</order>

		<prerequisites>day</prerequisites>

		<happinessPCT>120</happinessPCT>

		<turns>360</turns>
	</event>

	<event>
		<id>highwinds</id>
		<name>High winds</name>

		<icon>event_highwinds</icon>
		<order>3</order>

		<!-- Townies walk faster -->
		<walkSpeedPCT>120</walkSpeedPCT>

		<turns>720</turns>
	</event>

	<event>
		<id>stickyground</id>
		<name>Sticky ground</name>

		<icon>event_stickyground</icon>
		<order>4</order>

		<!-- Townies walk slower -->
		<walkSpeedPCT>80</walkSpeedPCT>

		<turns>720</turns>
	</event>





	<event>
		<id>densewind</id>
		<name>Heavy wind</name>

		<icon>event_densewind</icon>
		<order>5</order>

		<turns>1440</turns>
	</event>















</events>
